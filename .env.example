# Postgres connection string (Neon, Supabase, Vercel Postgres, or local).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sspx

# Long random string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public URL of the site, no trailing slash. Used in emails and previews.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Long random string protecting the draft-preview route. openssl rand -hex 24
PREVIEW_SECRET=

# Resend (https://resend.com): website forms and admin password resets.
# The "from" address must be on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=website@fsspx.co.za
RESEND_FROM_NAME=SSPX Cape Town

# Vercel Blob read/write token for uploads in production.
# Leave empty locally: uploads are then stored in ./media.
BLOB_READ_WRITE_TOKEN=

# Protects the scheduled updates (/cron/youtube daily 07:00, /cron/feasts
# Fridays 18:00 Cape Town time). Vercel sends it automatically. openssl rand -hex 32
CRON_SECRET=
